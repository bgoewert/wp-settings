<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    stopOnFailure="false">
    <testsuites>
        <!-- No WordPress: the library runs against the function stubs in tests/bootstrap.php. -->
        <testsuite name="unit">
            <directory suffix="Test.php">./tests/Unit/</directory>
        </testsuite>
    </testsuites>
    <!-- Without a source filter PHPUnit collects no coverage, and Infection then
         finds nothing to mutate: it only mutates files the coverage report names. -->
    <source>
        <include>
            <directory suffix=".php">./src/</directory>
        </include>
    </source>
</phpunit>
