<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    stopOnFailure="false">
    <testsuites>
        <!-- No WordPress: the library runs against the function stubs in tests/bootstrap.php. -->
        <testsuite name="unit">
            <directory suffix="Test.php">./tests/Unit/</directory>
        </testsuite>
    </testsuites>
</phpunit>
