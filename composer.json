{
    "name": "bgoewert/wp-settings",
    "description": "WordPress Settings Library",
    "version": "4.0.2",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "autoload": {
        "psr-4": {
            "BGoewert\\WP_Settings\\": "src/"
        }
    },
    "require": {
        "php": "^8.0"
    },
    "suggest": {
        "ext-openssl": "Preferred backend (AES-256-GCM) for encrypting settings",
        "ext-sodium": "Fallback backend, and required to read values encrypted before 3.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33 || ^10.5.62 || ^11.5.50 || ^12.5.8"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit --testdox"
    }
}
