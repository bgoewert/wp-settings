{
    "name": "bgoewert/wp-settings",
    "description": "WordPress Settings Library",
    "version": "4.7.0",
    "license": "GPL-2.0-or-later",
    "type": "library",
    "autoload": {
        "psr-4": {
            "BGoewert\\WP_Settings\\": "src/"
        }
    },
    "require": {
        "php": "^8.0"
    },
    "suggest": {
        "ext-openssl": "Preferred backend (AES-256-GCM) for encrypting settings",
        "ext-sodium": "Fallback backend, and required to read values encrypted before 3.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33 || ^10.5.62 || ^11.5.50 || ^12.5.8",
        "seilerinstrument/wp-test-utils": "^1.1",
        "infection/infection": "^0.35"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit --testdox",
        "test:unit": "./vendor/bin/phpunit -c phpunit.xml.dist --testdox",
        "test:integration": "ddev exec php vendor/bin/phpunit -c phpunit-integration.xml.dist --testdox",
        "test:mutation": "./vendor/bin/infection --threads=max --no-interaction"
    },
    "repositories": {
        "wp-test-utils": {
            "type": "vcs",
            "url": "https://github.com/SeilerInstrument/wp-test-utils"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
