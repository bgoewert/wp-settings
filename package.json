{
  "name": "wp-settings",
  "private": true,
  "description": "Browser tests for the WordPress Settings Library.",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0"
  },
  "scripts": {
    "env:start": "ddev start",
    "env:stop": "ddev stop",
    "env:url": "ddev describe -j | jq -r '.raw.primary_url'",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "composer test:unit",
    "test:integration": "composer test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  }
}
